# Template-owned: template-python. The stack slot base-ci.yml's required `ci` job calls:
# the jobs that need the project installed. Cheap checks (the wiki standard, version and
# lock file) run in base-ci's `checks` job through scripts/checks.d/20-python.sh.
name: Stack

on:
  workflow_call:

permissions:
  contents: read

jobs:
[% set pythons = ['3.13', '3.14'] | select('ge', python_version) | list %]
  test:
    name: Test (Python ${{ matrix.python-version }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: [[ pythons | tojson ]]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          python-version: ${{ matrix.python-version }}
          enable-cache: true

      # The `build:` packages in contrib/system-packages.txt (project-owned), for
      # dependencies that build from source. None listed: nothing is installed.
      - name: System packages
        run: |
          if grep -q '^build:.*[^[:space:]]' contrib/system-packages.txt && command -v apt-get >/dev/null && sudo -n true 2>/dev/null; then
            sudo apt-get update
            sed -n 's/^build://p' contrib/system-packages.txt | xargs sudo apt-get install -y --no-install-recommends
          fi

      - name: Install (from the lock file)
        run: uv sync --locked

      - name: Lint
        run: uv run ruff check

      - name: Format
        run: uv run ruff format --check

      - name: Type check
        run: uv run mypy

      - name: Tests (with coverage floor)
        run: uv run pytest
[% if stdlib_only %]

      # Standard library only (decision 0011), against this Python's sys.stdlib_module_names.
      - name: Standard library only
        run: uv run scripts/check-stdlib.py
[% endif %]

      - name: Import and entry-point smoke test
        run: |
          uv run python -c "import [[ package_name ]]; print('[[ package_name ]]', [[ package_name ]].__version__)"
[% if has_cli %]
          uv run [[ project_name ]] --help > /dev/null
[% endif %]
[% if stdlib_only %]
          # The program file alone, as `python3 -IS` runs it: no virtualenv, no sibling module.
          # Its --version's first line starts with "<project> X.Y.Z"; a tail after a space is the program's.
          tmp=$(mktemp -d)
          cp src/[[ package_name ]]/[[ package_name ]].py "$tmp/"
          want="[[ project_name ]] $(sed -n 's/^version = "\([^"]*\)"/\1/p' pyproject.toml | head -n 1)"
          got=$(uv run python -IS "$tmp/[[ package_name ]].py" --version | head -n 1)
          case "$got" in
            "$want" | "$want "*) ;;
            *) echo "::error::python -IS [[ package_name ]].py --version printed '$got': its first line must be '$want', alone or followed by a space"; exit 1 ;;
          esac
[% endif %]

      - name: Generated wiki sections[% if kind == 'service' %] and docs/openapi.json[% endif %] are current
        if: matrix.python-version == '[[ python_version ]]'
        run: uv run scripts/gen-wiki.py --check
[% if kind == 'service' %]

  # docs/openapi.json against the base branch's (the Test job keeps it current): a breaking
  # change to the HTTP contract fails unless the PR declares it, with `!` in its Conventional
  # Commit title (`feat!: ...`) or `BREAKING CHANGE:` in its body, so release-please bumps the
  # major version. Pull requests only (template-python decision 0005).
  api-breaking:
    name: Breaking API changes are declared
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Install oasdiff
        env:
          VERSION: 1.35.0
          SHA256: a8023002fcb2eaa7f5758148a9303cb63d33b939886df312268bc0fc7b939140
        run: |
          mkdir -p "$HOME/.local/bin"
          curl -fsSL -o "$RUNNER_TEMP/oasdiff.tar.gz" \
            "https://github.com/oasdiff/oasdiff/releases/download/v$VERSION/oasdiff_${VERSION}_linux_amd64.tar.gz"
          echo "$SHA256  $RUNNER_TEMP/oasdiff.tar.gz" | sha256sum -c --quiet
          tar -xzf "$RUNNER_TEMP/oasdiff.tar.gz" -C "$HOME/.local/bin" oasdiff
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"

      - name: Compare docs/openapi.json with the base branch's
        env:
          BASE_REF: ${{ github.base_ref }}
          TITLE: ${{ github.event.pull_request.title }}
          BODY: ${{ github.event.pull_request.body }}
        run: |
          git fetch --quiet --depth=1 origin "$BASE_REF"
          if ! git cat-file -e FETCH_HEAD:docs/openapi.json 2> /dev/null; then
            echo "$BASE_REF has no docs/openapi.json yet: nothing to compare"
            exit 0
          fi
          git show FETCH_HEAD:docs/openapi.json > "$RUNNER_TEMP/base-openapi.json"
          rc=0
          oasdiff breaking "$RUNNER_TEMP/base-openapi.json" docs/openapi.json --fail-on ERR || rc=$?
          [ "$rc" -ne 0 ] || exit 0
          # 1 is "breaking changes found"; anything else is oasdiff failing.
          [ "$rc" -eq 1 ] || { echo "::error::oasdiff failed (exit $rc)"; exit "$rc"; }
          if printf '%s\n' "$TITLE" | grep -qE '^[a-z]+(\([^)]*\))?!:' \
              || printf '%s\n' "$BODY" | grep -q '^BREAKING[ -]CHANGE:'; then
            echo "::warning::Breaking API change, declared by this PR: release-please bumps the major version"
            exit 0
          fi
          echo "::error::Breaking API change: make it compatible, or declare it (feat!: in the PR title, or BREAKING CHANGE: in its body)"
          exit 1
[% endif %]
[% if integration_ci %]
[% set extras = ' --all-extras' if integration_extras == ['*'] else ((' --extra ' ~ integration_extras | join(' --extra ')) if integration_extras else '') %]

  # The Copier answer `integration_ci`: the tests marked `integration`. It fails, never
  # passes vacuously, when none runs or one is skipped (a missing package or device).
  integration:
    name: Integration tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          python-version: "[[ python_version ]]"
          enable-cache: true

      # Both lists in contrib/system-packages.txt: `build:` to install the dependencies,
      # `runtime:` for the tests to use them.
      - name: System packages
        run: |
          if grep -qE '^(build|runtime):.*[^[:space:]]' contrib/system-packages.txt && command -v apt-get >/dev/null && sudo -n true 2>/dev/null; then
            sudo apt-get update
            sed -nE 's/^(build|runtime)://p' contrib/system-packages.txt | xargs sudo apt-get install -y --no-install-recommends
          fi

[% if integration_extras %]
      # with the optional extras the Copier answer `integration_extras` names
[% endif %]
      - name: Install (from the lock file)
        run: uv sync --locked[[ extras ]]

      # pytest fails when no test is selected. The coverage floor is the Test job's.
      - name: Integration tests
        env:
          RUN_INTEGRATION: "1"
        run: uv run pytest -m integration --no-cov --junitxml="$RUNNER_TEMP/integration.xml"

      - name: No integration test was skipped
        run: |
          python3 - "$RUNNER_TEMP/integration.xml" <<'EOF'
          import sys
          import xml.etree.ElementTree as ET

          skipped = [
              f"{case.get('classname')}.{case.get('name')}: {skip.get('message')}"
              for case in ET.parse(sys.argv[1]).iter("testcase")
              if (skip := case.find("skipped")) is not None and skip.get("type") != "pytest.xfail"
          ]
          for test in skipped:
              print(f"::error::skipped {test}")
          sys.exit(1 if skipped else 0)
          EOF
[% endif %]

  markdown:
    name: Markdown lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      # The image, globs and config live in the script, so a local run matches this one.
      - name: markdownlint
        run: scripts/check-markdown.sh
[% if container_image or contrib %]

  manifests:
    name: Dockerfile and contrib manifests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install validators
        run: |
          mkdir -p "$HOME/.local/bin"
[% if container_image %]
          curl -fsSL -o "$HOME/.local/bin/hadolint" \
            https://github.com/hadolint/hadolint/releases/download/v2.15.1/hadolint-linux-x86_64
          chmod +x "$HOME/.local/bin/hadolint"
[% endif %]
[% if 'k8s' in contrib %]
          curl -fsSL https://github.com/yannh/kubeconform/releases/download/v0.8.0/kubeconform-linux-amd64.tar.gz \
            | tar -xz -C "$HOME/.local/bin" kubeconform
[% endif %]
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"
      - name: Validate
        run: scripts/check-manifests.sh
[% endif %]
