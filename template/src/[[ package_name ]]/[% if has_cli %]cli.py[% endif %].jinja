"""The `[[ project_name ]]` command.

The wiki's CLI-Reference page is generated from this module (scripts/gen-wiki.py),
so command docstrings and option help are user documentation.
"""

from __future__ import annotations

from pathlib import Path
from typing import Annotated

import typer
from interpose.secret import MASK

from [[ package_name ]] import __description__, __version__
from [[ package_name ]].config import CONFIG_ENV, SETTINGS, Config, ConfigError, load_config

app = typer.Typer(
    help=__description__,
    no_args_is_help=True,
    add_completion=False,
    pretty_exceptions_enable=False,
)

ConfigOption = Annotated[
    Path | None,
    typer.Option(
        "--config",
        "-c",
        envvar=CONFIG_ENV,
        help="Config file (default /etc/[[ project_name ]]/config.yaml; missing is fine).",
        show_default=False,
    ),
]


def _load(path: Path | None) -> Config:
    try:
        return load_config(path)
    except ConfigError as e:
        typer.echo(f"error: {e}", err=True)
        raise typer.Exit(2) from e


@app.command()
def version() -> None:
    """Print the version."""
    typer.echo(__version__)


@app.command("config")
def show_config(config: ConfigOption = None) -> None:
    """Print the effective configuration and where each value came from. Secrets: set or unset."""
    cfg = _load(config)
    values = {
        "log_level": cfg.log_level,
[% if kind == 'service' %]
        "listen.host": cfg.host,
        "listen.port": cfg.port,
        "state_dir": cfg.state_dir,
[% endif %]
    }
    # A secret shows whether it is set, never its value: a Secret is truthy when it isn't
    # empty. Read from the resolved settings, so a secret Config holds needs no entry above.
    resolved = SETTINGS.resolve(config).values
    for setting in SETTINGS:
        shown: object = values.get(setting.key)
        if setting.secret:
            shown = f"{MASK} (set)" if resolved[setting.key] else "(unset)"
        typer.echo(f"{setting.key} = {shown}  ({cfg.sources[setting.key]})")
[% if kind == 'service' %]


@app.command()
def serve(config: ConfigOption = None) -> None:
    """Run the HTTP server."""
    import logging

    import uvicorn

    from [[ package_name ]].api import create_app

    cfg = _load(config)
    logging.basicConfig(
        level=cfg.log_level, format="%(asctime)s %(levelname)s %(name)s: %(message)s"
    )
    uvicorn.run(
        create_app(cfg),
        host=cfg.host,
        port=cfg.port,
        log_level=cfg.log_level.lower(),
        proxy_headers=True,
    )


# A server bound to every interface is asked on loopback.
WILDCARD_HOSTS = ("0.0.0.0", "::")  # noqa: S104


@app.command()
def health(
    config: ConfigOption = None,
    ready: Annotated[
        bool,
        typer.Option("--ready", help="Ask /readyz (readiness) instead of [[ health_path ]] (liveness)."),
    ] = False,
    timeout: Annotated[
        float, typer.Option("--timeout", min=0.1, help="Seconds to wait for the answer.")
    ] = 4.0,
) -> None:
    """Exit 0 if the running server answers its health endpoint with 2xx, 1 if not.

    The image's HEALTHCHECK runs it (template-python decision 0010). It reads the config as
    serve does and asks http://<listen.host>:<listen.port>, or 127.0.0.1 when listen.host is
    0.0.0.0 or ::. One line on stderr says why it failed; nothing is printed on success.
    """
    import urllib.error
    import urllib.request

    cfg = _load(config)
    host = "127.0.0.1" if cfg.host in WILDCARD_HOSTS else cfg.host
    if ":" in host:
        host = f"[{host}]"
    url = f"http://{host}:{cfg.port}{'/readyz' if ready else '[[ health_path ]]'}"
    # No proxy: a service's own HTTP(S)_PROXY must not carry its health check elsewhere.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(url, timeout=timeout) as response:
            status = response.status
    except urllib.error.HTTPError as e:
        e.close()
        status = e.code
    except (urllib.error.URLError, OSError) as e:
        reason = e.reason if isinstance(e, urllib.error.URLError) else e
        typer.echo(f"unhealthy: {url}: {reason}", err=True)
        raise typer.Exit(1) from e
    if not 200 <= status < 300:
        typer.echo(f"unhealthy: {url} answered {status}", err=True)
        raise typer.Exit(1)
[% endif %]


def main() -> None:
    app()
