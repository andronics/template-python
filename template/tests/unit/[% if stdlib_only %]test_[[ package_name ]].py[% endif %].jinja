"""The program, in-process and as `python3 -IS` runs it: the file alone (decision 0011)."""

import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

import pytest

from [[ package_name ]] import [[ package_name ]] as program
from [[ package_name ]].[[ package_name ]] import __version__, main

PROGRAM = Path(program.__file__)


def test_version(capsys: pytest.CaptureFixture[str]) -> None:
    with pytest.raises(SystemExit) as exit_:
        main(["--version"])
    assert exit_.value.code == 0
    assert capsys.readouterr().out == f"[[ project_name ]] {__version__}\n"


def test_help(capsys: pytest.CaptureFixture[str]) -> None:
    with pytest.raises(SystemExit) as exit_:
        main(["--help"])
    assert exit_.value.code == 0
    assert capsys.readouterr().out.startswith("usage: [[ project_name ]] ")


@pytest.mark.parametrize("argv", (["--nope"], ["hello", "--nope"], ["--ver"]))
def test_a_usage_error_exits_2(argv: list[str], capsys: pytest.CaptureFixture[str]) -> None:
    # `--ver` too: allow_abbrev=False refuses an abbreviation instead of guessing.
    with pytest.raises(SystemExit) as exit_:
        main(argv)
    assert exit_.value.code == 2
    assert capsys.readouterr().err.startswith("usage: [[ project_name ]] ")


def test_hello(capsys: pytest.CaptureFixture[str]) -> None:
    assert main(["hello", "tests"]) == 0
    assert capsys.readouterr().out == "hello, tests\n"


def test_runs_alone_through_its_shebang(tmp_path: Path) -> None:
    """The file copied alone, run with its shebang's flags (-IS) and no PYTHON* help: only the
    standard library is importable, and nothing beside it. Where the shebang's interpreter isn't
    installed, this test's Python runs it with the same flags."""
    shebang = PROGRAM.read_text(encoding="utf-8").splitlines()[0]
    assert shebang.startswith("#!")
    interpreter, *flags = shlex.split(shebang[2:])
    if not os.access(interpreter, os.X_OK):
        interpreter = sys.executable
    copy = shutil.copy(PROGRAM, tmp_path / PROGRAM.name)
    result = subprocess.run(  # noqa: S603 - a fixed command: this test's interpreter and the copy
        [interpreter, *flags, str(copy), "--version"],
        capture_output=True,
        text=True,
        cwd=tmp_path,
        check=False,
    )
    assert result.returncode == 0, result.stderr
    assert result.stdout == f"[[ project_name ]] {__version__}\n"
