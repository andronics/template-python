"""What every stdlib-cli program does, whatever its parser (decisions 0011 and 0012): `--version`,
`--help`, a usage error that exits with the program's `EXIT_USAGE` (2 if it declares none), and
the file run alone as `python3 -IS` runs it. Test the program's own commands in files of their own.

It calls the program through two fixtures that a conftest of the project's may define. Without
them, it uses its own defaults below, and a project needs neither:

- `stdlib_cli_main`, `(argv: list[str]) -> int`, for `--version`, `--help` and the usage error.
  Supply it when `main` takes dependencies it must be given in tests (a fake journal, say).
  The default is `main(argv)`, with a `SystemExit` turned into its code.
- `stdlib_cli_run`, `(argv: list[str], cwd: Path) -> subprocess.CompletedProcess[str]`, for the
  run alone. Supply it when the conftest guards `subprocess`, and build it on the `Popen` saved
  before the guard: `subprocess.run` looks `Popen` up each time it is called, so a `run` saved
  before the guard still meets it. The default is `subprocess.run(argv, cwd=cwd,
  capture_output=True, text=True, check=False)`.
"""

import os
import shlex
import shutil
import subprocess
import sys
from collections.abc import Callable
from pathlib import Path

import pytest

from [[ package_name ]] import [[ package_name ]] as program
from [[ package_name ]].[[ package_name ]] import __version__, main

PROGRAM = Path(program.__file__)
# The code a usage error exits with: the program's own, or argparse's.
EXIT_USAGE: int = getattr(program, "EXIT_USAGE", 2)

# The fixtures' shapes: (argv) -> int, and (argv, cwd) -> CompletedProcess.
Main = Callable[..., int]
Run = Callable[..., subprocess.CompletedProcess[str]]


def exit_code(argv: list[str]) -> int:
    """main(argv)'s exit status: its return value, or the SystemExit an argparse parser raises."""
    try:
        return main(argv)
    except SystemExit as exit_:
        return 0 if exit_.code is None else exit_.code if isinstance(exit_.code, int) else 1


def run(argv: list[str], cwd: Path) -> subprocess.CompletedProcess[str]:
    """argv run as a process in cwd, its output captured."""
    return subprocess.run(argv, cwd=cwd, capture_output=True, text=True, check=False)  # noqa: S603 - the run-alone test's fixed command


def supplied[T](request: pytest.FixtureRequest, name: str, default: T) -> T:
    """The fixture `name` if a conftest defines one, else `default`. Looked up by name, not
    requested, so the project's definition wins and none is needed (decision 0012)."""
    try:
        found: T = request.getfixturevalue(name)
    except pytest.FixtureLookupError:
        return default
    return found


def assert_version_line(out: str) -> None:
    """The first line is "<project> X.Y.Z", alone or followed by a space and the program's tail."""
    want = f"[[ project_name ]] {__version__}"
    first = out.split("\n", 1)[0]
    assert first == want or first.startswith(f"{want} "), f"--version printed {first!r}"


def test_version(request: pytest.FixtureRequest, capsys: pytest.CaptureFixture[str]) -> None:
    call: Main = supplied(request, "stdlib_cli_main", exit_code)
    assert call(["--version"]) == 0
    assert_version_line(capsys.readouterr().out)


def test_help(request: pytest.FixtureRequest) -> None:
    call: Main = supplied(request, "stdlib_cli_main", exit_code)
    assert call(["--help"]) == 0


def test_an_unknown_option_exits_with_the_usage_code(request: pytest.FixtureRequest) -> None:
    call: Main = supplied(request, "stdlib_cli_main", exit_code)
    assert call(["--no-such-option"]) == EXIT_USAGE


def test_runs_alone_through_its_shebang(request: pytest.FixtureRequest, tmp_path: Path) -> None:
    """The file copied alone, run with its shebang's flags (-IS) and no PYTHON* help: only the
    standard library is importable, and nothing beside it. Where the shebang's interpreter isn't
    installed, this test's Python runs it with the same flags."""
    shebang = PROGRAM.read_text(encoding="utf-8").splitlines()[0]
    assert shebang.startswith("#!")
    interpreter, *flags = shlex.split(shebang[2:])
    if not os.access(interpreter, os.X_OK):
        interpreter = sys.executable
    copy = shutil.copy(PROGRAM, tmp_path / PROGRAM.name)
    call: Run = supplied(request, "stdlib_cli_run", run)
    result = call([interpreter, *flags, str(copy), "--version"], tmp_path)
    assert result.returncode == 0, result.stderr
    assert_version_line(result.stdout)
